# Variáveis de ambiente do servidor (apps/server). Copie para .env conforme o deploy.
# As URLs de banco do Prisma ficam em packages/infrastructure/.env (ver .env.example lá).

# Porta HTTP (Railway injeta PORT em produção)
PORT=3000

# Origens permitidas no CORS, separadas por vírgula (domínios do tenant, IN-24)
CORS_ORIGINS=http://localhost:5173

# Conexão usada pelo Prisma em runtime do servidor
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/expedition?schema=public"
