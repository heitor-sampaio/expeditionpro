# pnpm: node_modules estrito — sem hoisting, sem phantom dependencies.
# É o que impede packages/domain de importar Prisma/React por acidente.
# A fronteira de camadas do CLAUDE.md passa a ser imposta pelo resolvedor,
# não só por disciplina.
hoist=false
shamefully-hoist=false
strict-peer-dependencies=false
auto-install-peers=true
