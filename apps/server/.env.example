# Variáveis do servidor (apps/server). Copie para .env conforme o deploy.

# Porta HTTP (Railway injeta PORT em produção)
PORT=3000

# Origens permitidas no CORS, separadas por vírgula (domínios do tenant, IN-24)
CORS_ORIGINS=http://localhost:5173

# Conexão do Prisma em runtime — use o host do POOLER (Supavisor), não o direto.
# O direto `db.<ref>.supabase.co` é IPv6-only. Ver packages/infrastructure/.env.example.
DATABASE_URL="postgresql://postgres.<ref>:<SENHA>@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

# Auth real do Supabase (§3.7). Sem uma destas, resolveContext usa o stub de dev
# (DEV_ACTOR de equipe) e o portal do cliente NÃO autentica como cliente.
# Mais simples: a URL do projeto — o servidor deriva a JWKS (ES256) automaticamente.
SUPABASE_URL=https://<ref>.supabase.co
# Alternativas (opcionais): SUPABASE_JWKS_URL=... (JWKS explícito) ou
# SUPABASE_JWT_SECRET=... (segredo HS256 legado, em Settings → API → JWT).

# PG-01 · cifra da credencial do gateway de pagamento (ASAAS).
# Gere com: openssl rand -hex 32
PAYMENT_TOKEN_KEY=
