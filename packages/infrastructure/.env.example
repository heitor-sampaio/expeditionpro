# Copie para .env e ajuste. O .env real NUNCA entra no git (§11.7).
# O Prisma (migrations, generate, seed) lê este arquivo.

# IMPORTANTE — use o host do POOLER (Supavisor), não o host direto.
# O host direto `db.<ref>.supabase.co` é IPv6-only (IPv4 é add-on pago); numa
# rede IPv4 ele dá "Can't reach database server". O pooler é IPv4.
# Pegue as strings no botão "Connect" do dashboard do Supabase. Formato:
#   usuário: postgres.<ref>   host: aws-0-<região>.pooler.supabase.com

# Migrations e seed — pooler em SESSION mode (porta 5432)
DIRECT_URL="postgresql://postgres.<ref>:<SENHA>@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

# Runtime da aplicação — session (5432) funciona já; em produção troque para
# TRANSACTION mode (porta 6543) + ?pgbouncer=true&connection_limit=1 (§2.3)
DATABASE_URL="postgresql://postgres.<ref>:<SENHA>@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

# Banco descartável para a suíte destrutiva de integração/RLS (Postgres local).
# NUNCA aponte para o Supabase de produção — a suíte dá DROP SCHEMA a cada arquivo.
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/expedition_test?schema=public"
